# ================================================================
# Шаблон для API ключей (переименуй в api_keys.yaml)
# ================================================================

# ESMFold API (НЕ ТРЕБУЕТСЯ КЛЮЧ!)
esmfold:
  url: "https://api.esmatlas.com/foldSequence/v1/pdb/"
  # Ключ не нужен, но можно добавить contact email
  email: "your.email@example.com"

# AlphaFold2 (через ColabFold - НЕ ТРЕБУЕТСЯ)
alphafold:
  # Для локального запуска нужна только GPU
  local_path: "/path/to/alphafold/weights"

# ChEMBL API (бесплатно, без регистрации)
chembl:
  url: "https://www.ebi.ac.uk/chembl/api/data/"
  # Ключ не требуется

# PubChem API (бесплатно)
pubchem:
  url: "https://pubchem.ncbi.nlm.nih.gov/rest/pug/"
  # Ключ не требуется

# RCSB PDB API (бесплатно)
rcsb:
  url: "https://data.rcsb.org/rest/v1/"
  # Ключ не требуется

# ================================================================
# Все API выше - БЕСПЛАТНЫЕ и НЕ ТРЕБУЮТ КЛЮЧЕЙ!
# ================================================================
